{
  "schema_version": 1,
  "cases": [
    {
      "id": "INPUT-001",
      "catalog_id": "VDA-003",
      "title": "B tap uses real pin polarity and candidate gesture engine",
      "steps": [
        {"op": "plug"},
        {"op": "button", "button": "B", "pressed": true},
        {"op": "advance", "ms": 120, "service": true},
        {"op": "button", "button": "B", "pressed": false},
        {"op": "advance", "ms": 30, "service": true}
      ],
      "expected_actions": ["b_short"]
    },
    {
      "id": "INPUT-002",
      "catalog_id": "VDA-004",
      "title": "A hold emits one action, not a second tap on release",
      "steps": [
        {"op": "plug"},
        {"op": "button", "button": "A", "pressed": true},
        {"op": "advance", "ms": 2100, "service": true},
        {"op": "button", "button": "A", "pressed": false},
        {"op": "advance", "ms": 30, "service": true}
      ],
      "expected_actions": ["a_hold"]
    },
    {
      "id": "INPUT-003",
      "catalog_id": "VDA-005",
      "title": "Two taps queue during an eight-second application stall",
      "steps": [
        {"op": "plug"},
        {"op": "schedule", "at_ms": 200, "button": "B", "pressed": true},
        {"op": "schedule", "at_ms": 320, "button": "B", "pressed": false},
        {"op": "schedule", "at_ms": 900, "button": "B", "pressed": true},
        {"op": "schedule", "at_ms": 1020, "button": "B", "pressed": false},
        {"op": "advance", "ms": 8000, "service": false},
        {"op": "poll"}
      ],
      "expected_actions": ["b_short", "b_short"]
    },
    {
      "id": "INPUT-004",
      "catalog_id": "VDA-004",
      "title": "Complete A+B hold survives a blocked application",
      "steps": [
        {"op": "plug"},
        {"op": "schedule", "at_ms": 100, "button": "A", "pressed": true},
        {"op": "schedule", "at_ms": 160, "button": "B", "pressed": true},
        {"op": "schedule", "at_ms": 3300, "button": "A", "pressed": false},
        {"op": "schedule", "at_ms": 3340, "button": "B", "pressed": false},
        {"op": "advance", "ms": 8000, "service": false},
        {"op": "poll"}
      ],
      "expected_actions": ["ab_hold"]
    },
    {
      "id": "INPUT-005",
      "catalog_id": "VDA-004",
      "title": "Short combo cannot become an unlock during a stall",
      "steps": [
        {"op": "plug"},
        {"op": "schedule", "at_ms": 100, "button": "A", "pressed": true},
        {"op": "schedule", "at_ms": 160, "button": "B", "pressed": true},
