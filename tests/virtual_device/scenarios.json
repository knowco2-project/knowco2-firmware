    {
      "id": "INPUT-006",
      "catalog_id": "VDA-002",
      "title": "Power cut discards queued input; new epoch accepts new input",
      "steps": [
        {"op": "plug"},
        {"op": "button", "button": "B", "pressed": true},
        {"op": "advance", "ms": 120, "service": false},
        {"op": "button", "button": "B", "pressed": false},
        {"op": "advance", "ms": 30, "service": false},
        {"op": "unplug"},
        {"op": "advance", "ms": 100, "service": true},
        {"op": "plug"},
        {"op": "advance", "ms": 100, "service": true},
        {"op": "button", "button": "B", "pressed": true},
        {"op": "advance", "ms": 120, "service": true},
        {"op": "button", "button": "B", "pressed": false},
        {"op": "advance", "ms": 30, "service": true}
      ],
      "expected_actions": ["b_short"]
    },
    {
      "id": "INPUT-007",
      "catalog_id": "VDA-006",
      "title": "Complete hold across supervisor tick wrap",
      "steps": [
        {"op": "plug"},
        {"op": "button", "button": "C", "pressed": true},
        {"op": "advance", "ms": 2100, "service": false},
